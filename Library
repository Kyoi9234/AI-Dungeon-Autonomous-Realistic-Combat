  const makeShingles = (
    value,
    size = 3
  ) => {
    const words =
      normalize(value)
        .split(" ")
        .filter(Boolean);

    const result =
      new Set();

    if (
      words.length < size
    ) {
      if (
        words.length
      ) {
        result.add(
          words.join(" ")
        );
      }

      return result;
    }

    for (
      let i = 0;
      i <=
        words.length - size;
      i++
    ) {
      result.add(
        words
          .slice(
            i,
            i + size
          )
          .join(" ")
      );
    }

    return result;
  };


  const similarity = (
    first,
    second
  ) => {
    const a =
      makeShingles(first);

    const b =
      makeShingles(second);

    if (
      !a.size ||
      !b.size
    ) {
      return 0;
    }

    let shared =
      0;

    for (
      const item of a
    ) {
      if (
        b.has(item)
      ) {
        shared++;
      }
    }

    return (
      shared /
      Math.min(
        a.size,
        b.size
