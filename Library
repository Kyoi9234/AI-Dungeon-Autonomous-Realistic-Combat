      return false;
    }

    if (
      a === b &&
      a.length >= 35
    ) {
      return true;
    }

    if (
      a.length < minLength ||
      b.length < minLength
    ) {
      return false;
    }

    return (
      similarity(
        first,
        second
      ) >= threshold
    );
  };


  const hasDuplicateParagraph = (
    firstText,
    secondText,
    threshold = 0.86
  ) => {
    const first =
      splitParagraphs(
        firstText
      );

    const second =
      splitParagraphs(
        secondText
      );

    for (
      const a of first
    ) {
      for (
        const b of second
      ) {
        if (
          isDuplicate(
            a,
            b,
            threshold,
            100
          )
        ) {
          return true;
        }
      }
    }

    return false;
  };


  /*
   * ============================================================
   * DIALOGUE DETECTION
   * ============================================================
   */

  const looksLikeDialogueSetup = (
    value
  ) => {
    const text =
      String(value || "")
        .trim();

    if (
      !text
    ) {
      return false;
    }

    const tail =
      text.slice(-800);

    if (
      !/["“”]/.test(
        tail
      )
    ) {
      return false;
    }

    if (
      DIALOGUE_SETUP_SIGNAL.test(
        tail
      )
    ) {
      return true;
    }

    const quotedEnding =
      tail.match(
        /["“]([^"”]{1,400})["”]?\s*$/
      );

    if (
      quotedEnding &&
      quotedEnding[1]
    ) {
      const spoken =
        quotedEnding[1]
          .trim()
          .toLowerCase();

      if (
        /\b(?:because|but|and|so|except|unless|until|if|when|while|the reason|the thing|here['’]s|here’s)\s*(?:[,.:;—-]|\.\.\.)?\s*$/i
          .test(
            spoken
          )
      ) {
        return true;
      }
    }

    return false;
  };


  const looksLikePlayerDialogue = (
    value
  ) => {
    const text =
      String(value || "")
        .trim();

    if (
      !text
    ) {
      return false;
    }

    if (
      /["“][^"”]{2,}["”]/.test(
        text
      )
    ) {
      return true;
    }

    if (
      /\b(?:i|you)\s+(?:say|tell|ask|shout|yell|scream|taunt|threaten|whisper|reply|answer|insult|mock|call out|announce)\b/i
        .test(
          text
        )
    ) {
      return true;
    }

    return false;
  };


  /*
   * ============================================================
   * ARC BLOCK CLEANUP
   * ============================================================
   */

  const stripArcBlocks = (value) =>
    String(value || "")
      .replace(
        /\n?\[ARC CORE RULES\][\s\S]*?\[\/ARC CORE RULES\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC SCENE CONTINUITY\][\s\S]*?\[\/ARC SCENE CONTINUITY\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC COMBAT RULES\][\s\S]*?\[\/ARC COMBAT RULES\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC ANTI-REPETITION\][\s\S]*?\[\/ARC ANTI-REPETITION\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC LOOP BREAKER\][\s\S]*?\[\/ARC LOOP BREAKER\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC RELEVANT STORY CARDS\][\s\S]*?\[\/ARC RELEVANT STORY CARDS\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC TURN DIRECTIVE\][\s\S]*?\[\/ARC TURN DIRECTIVE\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC DIALOGUE CONTINUITY\][\s\S]*?\[\/ARC DIALOGUE CONTINUITY\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC CONTINUE ANCHOR\][\s\S]*?\[\/ARC CONTINUE ANCHOR\]\n?/g,
        "\n"
      );


  /*
   * ============================================================
   * STORY CARD HELPERS
   * ============================================================
   */

  const getKeys = (card) => {
    if (
      !card ||
      card.keys == null
    ) {
      return [];
    }

    if (
      Array.isArray(
        card.keys
      )
    ) {
      return card.keys
        .map(
          (key) =>
            String(key).trim()
        )
        .filter(Boolean);
    }

    return String(
      card.keys
    )
      .split(
        /[,;\n]/
      )
      .map(
        (key) =>
          key.trim()
      )
      .filter(Boolean);
  };


  const keyAppears = (
    source,
    key
  ) => {
    if (
      !source ||
      !key
    ) {
      return false;
    }

    const trimmed =
      String(key).trim();

    if (
      trimmed.length < 2
    ) {
      return false;
    }

    if (
      /^[a-z0-9_' -]+$/i.test(
        trimmed
      )
    ) {
      const pattern =
        new RegExp(
          `(^|[^a-z0-9_])${escapeRegex(trimmed)}([^a-z0-9_]|$)`,
          "i"
        );

      return pattern.test(
        source
      );
    }

    return source
      .toLowerCase()
      .includes(
        trimmed.toLowerCase()
      );
  };


  const cardAlreadyInContext = (
    card,
    contextText
  ) => {
    if (
      !card ||
      !card.entry ||
      !contextText
    ) {
      return false;
    }

    const entry =
      normalize(
        card.entry
      );

    const context =
      normalize(
        contextText
      );

    if (
      !entry ||
      !context
    ) {
      return false;
    }

    if (
      entry.length <= 700
    ) {
      return context.includes(
        entry
      );
    }

    const fingerprintSize =
      180;

    const start =
      entry.slice(
        0,
        fingerprintSize
      );

    const middleStart =
      Math.max(
        0,
        Math.floor(
          entry.length / 2
        ) -
        Math.floor(
          fingerprintSize / 2
        )
      );

    const middle =
      entry.slice(
        middleStart,
        middleStart +
          fingerprintSize
      );

    const end =
      entry.slice(
        Math.max(
          0,
          entry.length -
            fingerprintSize
        )
      );

    let matches =
      0;

    if (
      start &&
      context.includes(start)
    ) {
      matches++;
    }

    if (
      middle &&
      context.includes(middle)
    ) {
      matches++;
    }

    if (
      end &&
      context.includes(end)
    ) {
      matches++;
    }

    return matches >= 2;
  };


  /*
   * ============================================================
   * CONTEXT HISTORY DE-DUPLICATION
   * ============================================================
   */

  const dedupeContextHistory = (
    value
  ) => {
    const paragraphs =
      splitParagraphs(
        value
      );

    const kept =
      [];

    const recent =
      [];

    for (
      const paragraph of
      paragraphs
    ) {
      const norm =
        normalize(
          paragraph
        );

      const substantial =
        norm.length >= 100;

      const duplicate =
        substantial &&
        recent.some(
          (previous) =>
            isDuplicate(
              paragraph,
              previous,
              0.92,
              100
            )
        );

      if (
        duplicate
      ) {
        continue;
      }

      kept.push(
        paragraph
      );

      if (
        substantial
      ) {
        recent.push(
          paragraph
        );

        if (
          recent.length >
            CONFIG.CONTEXT_DEDUPE_WINDOW
        ) {
          recent.shift();
        }
      }
    }

    return kept.join(
      "\n\n"
    );
  };


  /*
   * ============================================================
   * RECENT UNRESOLVED COMBAT
   * ============================================================
   *
   * Prevent combat rules from disappearing merely because the
   * player pressed Continue several times.
   */

  const recentUnresolvedCombat = (
    historyList
  ) => {
    let active =
      false;

    /*
     * Only inspect recent history so very old fights don't keep
     * combat mode alive forever.
     */
    const recent =
      historyList.slice(-6);

    for (
      const item of recent
    ) {
      const value =
        String(
          (
            item &&
            item.text
          ) ||
            ""
        );

      if (
        !value
      ) {
        continue;
      }

      /*
       * Explicit combat ending clears the flag.
       */
      if (
        END_SIGNAL.test(
          value
        )
      ) {
        active =
          false;

        continue;
      }

      /*
       * Newer combat evidence turns it back on.
       */
      if (
        COMBAT_SIGNAL.test(
          value
        )
      ) {
        active =
          true;
      }
    }

    return active;
  };


  /*
   * ============================================================
   * STATE
   * ============================================================
   */

  const prepareState = () => {
    const action =
      info.actionCount ||
      0;

    if (
      typeof state.arcLastActionCount ===
        "number" &&
      action <
        state.arcLastActionCount
    ) {
      delete state.arcCombatUntil;
      delete state.arcCombatCards;
      delete state.arcTurnDirective;
      delete state.arcPreviousPlayerInput;
      delete state.arcLoopBreakTurns;
      delete state.arcForceLoopBreak;
      delete state.arcDialogueContinuityPending;
    }

    state.arcLastActionCount =
      action;

    state.arcCombatCards =
      state.arcCombatCards ||
      {};

    if (
      state.arcForceLoopBreak
    ) {
      state.arcLoopBreakTurns =
        Math.max(
          state.arcLoopBreakTurns ||
            0,
          CONFIG.LOOP_BREAK_TURNS
        );

      state.arcForceLoopBreak =
        false;
    }

    return action;
  };


  const combatActive = (
    action =
      info.actionCount ||
      0
  ) =>
    typeof state.arcCombatUntil ===
      "number" &&
    state.arcCombatUntil >=
      action;


  /*
   * ============================================================
   * TURN DIRECTIVE
   * ============================================================
   */

  const buildTurnDirective = (
    inputText,
    wasRepeated,
    activeCombat
  ) => {
    const parts =
      [
        "Resolve the newest player input exactly once. Treat declared outcomes, quantities, finishing claims, and speed blitz claims as attempts. Do not simply echo or paraphrase the player's wording; begin with a new reaction, consequence, continuation, or development. Remain in the current established scene unless the player's action itself causes a transition."
      ];

    if (
      looksLikePlayerDialogue(
        inputText
      )
    ) {
      parts.push(
        "The player directly spoke to or addressed someone. If that character is present, conscious, capable of responding, and not forced into an immediate emergency reaction, allow a natural in-character response instead of skipping straight to an unrelated attack. The response may happen while the character moves, defends, prepares, or attacks."
      );
    }

    if (
      wasRepeated
    ) {
      parts.push(
        "The player intentionally repeated a similar action. Resolve it as a NEW attempt from the CURRENT position, injuries, fatigue, energy, defenses, and reactions. Do not reuse the previous narration or outcome wording, and do not leave the current scene merely to create novelty."
      );
    }

    if (
      activeCombat
    ) {
      parts.push(
        "Combat remains active and autonomous. Other capable combatants may react, interrupt, defend, counter, reposition, speak, or continue their own fights while this attempt is resolved. Do not assume forward progress requires an immediate attack or a scene transition."
      );
    }

    if (
      /\b(?:\d{2,}|hundreds?|thousands?|million|billion)\b/i
        .test(
          inputText
        )
    ) {
      parts.push(
        "Any declared large quantity or repetition count is aspirational, not guaranteed. Only narrate the amount physically achieved before interruption, exhaustion, defense, or changing circumstances stop it."
      );
    }

    return parts.join(
      " "
    );
  };


  /*
   * ============================================================
   * STORY CARD TRACKING
   * ============================================================
   */

  const trackRelevantCards = (
    active
  ) => {
    const cards =
      Array.isArray(
        storyCards
      )
        ? storyCards
        : [];

    const historyList =
      Array.isArray(
        history
      )
        ? history
        : [];

    const action =
      info.actionCount ||
      0;

    if (
      !active ||
      !cards.length
    ) {
      return cards;
    }

    const recentCombatText =
      historyList
        .slice(-6)
        .map(
          (item) =>
            (
              item &&
              item.text
            ) ||
              ""
        )
        .join("\n");

    const scored =
      [];

    for (
      const card of cards
    ) {
      if (
        !card ||
        !card.entry
      ) {
        continue;
      }

      const keys =
        getKeys(
          card
        );

      const matchingKeys =
        keys.filter(
          (key) =>
            keyAppears(
              recentCombatText,
              key
            )
        );

      if (
        !matchingKeys.length
      ) {
        continue;
      }

      const entry =
        String(
          card.entry
        );

      const type =
        String(
          card.type ||
            ""
        );

      let score =
        matchingKeys.length *
        3;

      if (
        /character|npc|enemy|boss|person|creature|monster|ally|companion/i
          .test(
            type
          )
      ) {
        score += 4;
      }

      if (
        /strength|speed|power|ability|abilities|skill|combat|durability|weapon|magic|technique|weakness|resistance|energy|stamina|esper|haki|devil fruit/i
          .test(
            entry
          )
      ) {
        score += 2;
      }

      scored.push({
        card,
        score
      });
    }

    scored
      .sort(
        (a, b) =>
          b.score -
          a.score
      )
      .slice(
        0,
        CONFIG.MAX_ACTIVE_CARDS
      )
      .forEach(
        ({ card }) => {
          state.arcCombatCards[
            String(
              card.id
            )
          ] =
            action;
        }
      );

    for (
      const id of
      Object.keys(
        state.arcCombatCards
      )
    ) {
      if (
        action -
          state.arcCombatCards[id] >
        CONFIG.CARD_MEMORY_ACTIONS
      ) {
        delete state
          .arcCombatCards[id];
      }
    }

    return cards;
  };


  /*
   * ============================================================
   * STORY CARD BACKUP
   * ============================================================
   */

  const buildRelevantCardsBlock = (
    cards,
    cleanedText,
    active
  ) => {
    if (
      !active
    ) {
      return "";
    }

    const activeCards =
      cards.filter(
        (card) =>
          card &&
          Object.prototype
            .hasOwnProperty
            .call(
              state.arcCombatCards,
              String(
                card.id
              )
            )
      );

    if (
      !activeCards.length
    ) {
      return "";
    }

    let remaining =
      CONFIG.MAX_CARD_CONTEXT_CHARS;

    const pieces =
      [];

    for (
      const card of
      activeCards.slice(
        0,
        CONFIG.MAX_ACTIVE_CARDS
      )
    ) {
      if (
        remaining <= 0
      ) {
        break;
      }

      if (
        cardAlreadyInContext(
          card,
          cleanedText
        )
      ) {
        continue;
      }

      const keys =
        getKeys(
          card
        ).join(", ");

      const label =
        keys
          ? `Story Card (${keys})`
          : `Story Card ${card.id}`;

      const fullEntry =
        String(
          card.entry ||
            ""
        ).trim();

      if (
        !fullEntry
      ) {
        continue;
      }

      const prefix =
        `\n${label}:\n`;

      const room =
        Math.max(
          0,
          remaining -
            prefix.length
        );

      if (
        room <= 0
      ) {
        break;
      }

      const piece =
        prefix +
        fullEntry.slice(
          0,
          room
        );

      pieces.push(
        piece
      );

      remaining -=
        piece.length;
    }

    if (
      !pieces.length
    ) {
      return "";
    }

    return `
[ARC RELEVANT STORY CARDS]

These Story Card facts are relevant to characters or entities currently involved in combat.

Use them as established baseline information when determining:
- Power.
- Speed.
- Durability.
- Skill.
- Abilities.
- Equipment.
- Techniques.
- Weaknesses.
- Resistances.
- Energy.
- Limitations.

Recent injuries, fatigue, energy use, equipment changes, transformations, positioning, and other current conditions still override baseline values when applicable.

${pieces.join("\n")}

[/ARC RELEVANT STORY CARDS]
`;
  };


  /*
   * ============================================================
   * LOOP DETECTION
   * ============================================================
   */

  const recentLoopRisk = () => {
    const historyList =
      Array.isArray(
        history
      )
        ? history
        : [];

    const recentAI =
      historyList
        .filter(
          (item) =>
            item &&
            item.type ===
              "continue" &&
            item.text
        )
        .slice(-2);

    if (
      recentAI.length < 2
    ) {
      return false;
    }

    /*
     * Strong paragraph-level duplication still immediately
     * activates the loop breaker.
     */
    if (
      hasDuplicateParagraph(
        recentAI[0].text,
        recentAI[1].text,
        0.84
      )
    ) {
      return true;
    }

    /*
     * Whole-response similarity used to be 0.60.
     *
     * That was too aggressive for combat because normal adjacent
     * fight responses naturally reuse names, locations, attacks,
     * and tactical vocabulary.
     */
    return (
      similarity(
        recentAI[0].text,
        recentAI[1].text
      ) >= 0.78
    );
  };


  /*
   * ============================================================
   * INPUT
   * ============================================================
   */

  const onInput = (
    text
  ) => {
    const action =
      prepareState();

    const input =
      String(
        text ||
          ""
      );

    if (
      END_SIGNAL.test(
        input
      )
    ) {
      state.arcCombatUntil =
        -1;

      state.arcCombatCards =
        {};
    } else if (
      COMBAT_SIGNAL.test(
        input
      )
    ) {
      state.arcCombatUntil =
        action +
        CONFIG.COMBAT_GRACE_ACTIONS;
    } else if (
      combatActive(
        action
      )
    ) {
      state.arcCombatUntil =
        Math.max(
          state.arcCombatUntil,
          action + 2
        );
    }

    const currentNorm =
      normalize(
        input
      );

    const previousNorm =
      normalize(
        state.arcPreviousPlayerInput ||
          ""
      );

    const wasRepeated =
      currentNorm.length >=
        20 &&
      currentNorm ===
        previousNorm;

    state.arcTurnDirective =
      buildTurnDirective(
        input,
        wasRepeated,
        combatActive(
          action
        )
      );

    state.arcPreviousPlayerInput =
      input;

    if (
      wasRepeated
    ) {
      state.arcLoopBreakTurns =
        Math.max(
          state.arcLoopBreakTurns ||
            0,
          1
        );
    }

    return {
      text
    };
  };


  /*
   * ============================================================
   * CONTEXT
   * ============================================================
   */

  const onContext = (
    text
  ) => {
    const action =
      prepareState();

    const historyList =
      Array.isArray(
        history
      )
        ? history
        : [];

    const newest =
      historyList.length
        ? historyList[
            historyList.length -
              1
          ]
        : null;

    const latestAI =
      [...historyList]
        .reverse()
        .find(
          (item) =>
            item &&
            item.type ===
              "continue" &&
            item.text
        );


    /*
     * Explicit combat ending.
     */

    if (
      newest &&
      END_SIGNAL.test(
        newest.text ||
          ""
      )
    ) {
      state.arcCombatUntil =
        -1;

      state.arcCombatCards =
        {};
    }


    /*
     * Combat stays active if either:
     *
     * 1. ARC's normal timer says it is active, OR
     * 2. recent story still clearly contains unresolved combat.
     */

    const active =
      combatActive(
        action
      ) ||
      recentUnresolvedCombat(
        historyList
      );


    /*
     * Refresh the internal timer from recent unresolved combat
     * without making AI combat prose refresh it forever.
     *
     * This simply keeps rules alive for the current generation.
     */
    if (
      active &&
      !combatActive(
        action
      )
    ) {
      state.arcCombatUntil =
        action + 2;
    }


    if (
      !active &&
      typeof state.arcCombatUntil ===
        "number" &&
      state.arcCombatUntil <
        action
    ) {
      state.arcCombatCards =
        {};
    }


    /*
     * ==========================================================
     * DIALOGUE CONTINUITY
     * ==========================================================
     */

    const dialoguePending =
      Boolean(
        state.arcDialogueContinuityPending
      ) ||
      Boolean(
        latestAI &&
        looksLikeDialogueSetup(
          latestAI.text
        )
      );

    state.arcDialogueContinuityPending =
      false;


    /*
     * ==========================================================
     * CLEAN CONTEXT
     * ==========================================================
     */

    const cleanedText =
      stripArcBlocks(
        text
      );


    /*
     * ==========================================================
     * STORY CARDS
     * ==========================================================
     */

    const cards =
      trackRelevantCards(
        active
      );

    const cardsBlock =
      buildRelevantCardsBlock(
        cards,
        cleanedText,
        active
      );


    /*
     * ==========================================================
     * LOOP BREAKER
     * ==========================================================
     */

    const loopRisk =
      (
        state.arcLoopBreakTurns ||
          0
      ) > 0 ||
      recentLoopRisk();

    if (
      (
        state.arcLoopBreakTurns ||
          0
      ) > 0
    ) {
      state.arcLoopBreakTurns--;
    }


    /*
     * ==========================================================
     * BUILD DIRECTIVES
     * ==========================================================
     */

    let directives =
      CORE_RULES +
      "\n" +
      SCENE_CONTINUITY +
      "\n" +
      ANTI_REPEAT;

    if (
      active
    ) {
      directives +=
        "\n" +
        COMBAT_RULES;
    }

    if (
      dialoguePending
    ) {
      directives +=
        "\n" +
        DIALOGUE_CONTINUITY;
    }

    if (
      cardsBlock
    ) {
      directives +=
        "\n" +
        cardsBlock;
    }

    if (
      loopRisk
    ) {
      directives +=
        "\n" +
        LOOP_BREAKER;
    }


    /*
     * ==========================================================
     * PLAYER TURN DIRECTIVE
     * ==========================================================
     */

    const latestIsPlayer =
      newest &&
      PLAYER_TYPES.has(
        newest.type
      );

    const turnDirective =
      latestIsPlayer &&
      state.arcTurnDirective
        ? `
[ARC TURN DIRECTIVE]

${state.arcTurnDirective}

[/ARC TURN DIRECTIVE]
`
        : "";


    /*
     * ==========================================================
     * CONTINUE ANCHOR
     * ==========================================================
     *
     * When the newest history entry is an AI Continue result,
     * Context is usually being asked to continue from that exact
     * point without a new player action.
     */

    const continuingFromAI =
      newest &&
      newest.type ===
        "continue";


    const continueAnchor =
      continuingFromAI
        ? CONTINUE_ANCHOR
        : "";


    /*
     * ==========================================================
     * PRESERVE MEMORY / PLOT ESSENTIALS
     * ==========================================================
     */

    const memoryLength =
      Math.min(
        info.memoryLength ||
          0,
        cleanedText.length
      );

    const memoryPart =
      memoryLength
        ? cleanedText.slice(
            0,
            memoryLength
          )
        : "";

    let storyPart =
      memoryLength
        ? cleanedText.slice(
            memoryLength
          )
        : cleanedText;


    /*
     * ==========================================================
     * HISTORY DE-DUPLICATION
     * ==========================================================
     *
     * Removes duplicate prose only from what the model sees.
     *
     * It does NOT edit the visible adventure.
     */

    storyPart =
      dedupeContextHistory(
        storyPart
      );


    /*
     * ==========================================================
     * CONTEXT SIZE
     * ==========================================================
     */

    const maxChars =
      info.maxChars ||
      (
        memoryPart.length +
        directives.length +
        storyPart.length +
        continueAnchor.length +
        turnDirective.length +
        1000
      );


    const availableStoryChars =
      Math.max(
        0,
        maxChars -
          memoryPart.length -
          directives.length -
          continueAnchor.length -
          turnDirective.length -
          5
      );


    /*
     * Preserve newest history when trimming.
     */

    storyPart =
      availableStoryChars >
        0
        ? storyPart.slice(
            -availableStoryChars
          )
        : "";


    /*
     * ==========================================================
     * FINAL CONTEXT ORDER
     * ==========================================================
     *
     * Memory / Plot Essentials
     * ↓
     * ARC rules
     * ↓
     * Recent story
     * ↓
     * Continue anchor
     * ↓
     * Player turn directive
     */

    return {
      text:
        [
          memoryPart,
          directives,
          storyPart,
          continueAnchor,
          turnDirective
        ]
          .filter(Boolean)
          .join("\n")
    };
  };


  /*
   * ============================================================
   * OUTPUT
   * ============================================================
   */

  const onOutput = (
    text
  ) => {
    const action =
      prepareState();

    const original =
      String(
        text ||
          ""
      );


    /*
     * ==========================================================
     * COMBAT STATE
     * ==========================================================
     */

    if (
      END_SIGNAL.test(
        original
      )
    ) {
      state.arcCombatUntil =
        -1;

      state.arcCombatCards =
        {};
    } else if (
      !combatActive(
        action
      ) &&
      COMBAT_SIGNAL.test(
        original
      )
    ) {
      state.arcCombatUntil =
        action +
        CONFIG.COMBAT_GRACE_ACTIONS;
    }


    /*
     * ==========================================================
     * PHASE 1:
     * DUPLICATION INSIDE CURRENT RESPONSE
     * ==========================================================
     */

    const generatedParagraphs =
      splitParagraphs(
        original
      );

    const internallyCleaned =
      [];

    let repetitionDetected =
      false;


    for (
      const paragraph of
      generatedParagraphs
    ) {
      const duplicate =
        internallyCleaned.some(
          (previous) =>
            isDuplicate(
              paragraph,
              previous,
              0.82,
              90
            )
        );

      if (
        duplicate
      ) {
        repetitionDetected =
          true;

        continue;
      }

      internallyCleaned.push(
        paragraph
      );
    }


    /*
     * ==========================================================
     * PHASE 2:
     * COMPARE AGAINST RECENT AI OUTPUTS
     * ==========================================================
     */

    let recentAI =
      Array.isArray(
        history
      )
        ? history
            .filter(
              (item) =>
                item &&
                item.type ===
                  "continue" &&
                item.text
            )
            .slice(
              -CONFIG.RECENT_AI_OUTPUTS
            )
        : [];


    /*
     * Avoid comparing the output against itself.
     */

    if (
      recentAI.length &&
      normalize(
        recentAI[
          recentAI.length -
            1
        ].text
      ) ===
        normalize(
          original
        )
    ) {
      recentAI =
        recentAI.slice(
          0,
          -1
        );
    }


    const historicalParagraphs =
      [];


    for (
      const item of
      recentAI
    ) {
      historicalParagraphs.push(
        ...splitParagraphs(
          item.text
        )
      );
    }


    const novelParagraphs =
      [];


    for (
      const paragraph of
      internallyCleaned
    ) {
      const substantial =
        normalize(
          paragraph
        ).length >=
        100;

      const duplicateHistory =
        substantial &&
        historicalParagraphs.some(
          (previous) =>
            isDuplicate(
              paragraph,
              previous,
              0.88,
              100
            )
        );

      if (
        duplicateHistory
      ) {
        repetitionDetected =
          true;

        continue;
      }

      novelParagraphs.push(
        paragraph
      );
    }


    /*
     * ==========================================================
     * PHASE 3:
     * SECOND INTERNAL PASS
     * ==========================================================
     */

    const secondPass =
      [];


    for (
      const paragraph of
      novelParagraphs
    ) {
      const duplicate =
        secondPass.some(
          (previous) =>
            isDuplicate(
              paragraph,
              previous,
              0.82,
              90
            )
        );

      if (
        duplicate
      ) {
        repetitionDetected =
          true;

        continue;
      }

      secondPass.push(
        paragraph
      );
    }


    /*
     * ==========================================================
     * BUILD CLEAN OUTPUT
     * ==========================================================
     */

    let cleaned =
      secondPass
        .join("\n\n")
        .trim();


    /*
     * Never intentionally return an empty result.
     */

    if (
      !cleaned &&
      internallyCleaned.length
    ) {
      cleaned =
        internallyCleaned[
          internallyCleaned.length -
            1
        ].trim();

      repetitionDetected =
        true;
    }


    if (
      !cleaned
    ) {
      cleaned =
        original.trim();
    }


    /*
     * ==========================================================
     * LOOP BREAK SIGNAL
     * ==========================================================
     */

    if (
      repetitionDetected
    ) {
      state.arcForceLoopBreak =
        true;

      state.arcLoopBreakTurns =
        Math.max(
          state.arcLoopBreakTurns ||
            0,
          CONFIG.LOOP_BREAK_TURNS
        );
    }


    /*
     * ==========================================================
     * DIALOGUE CONTINUITY SIGNAL
     * ==========================================================
     */

    state.arcDialogueContinuityPending =
      looksLikeDialogueSetup(
        cleaned
      );


    return {
      text: cleaned
    };
  };


  /*
   * ============================================================
   * EXPOSE API
   * ============================================================
   */

  return {
    onInput,
    onContext,
    onOutput,

    normalize,
    similarity,
    isDuplicate,
    looksLikeDialogueSetup,
    looksLikePlayerDialogue
  };

})();
