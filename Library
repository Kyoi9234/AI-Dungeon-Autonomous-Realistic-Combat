   * ============================================================
   * DIALOGUE DETECTION
   * ============================================================
   */

  const looksLikeDialogueSetup = (
    value
  ) => {
    const text =
      String(value || "")
        .trim();

    if (
      !text
    ) {
      return false;
    }

    const tail =
      text.slice(-900);

    /*
     * Require evidence of dialogue.
     */
    if (
      !/["“”]/.test(
        tail
      )
    ) {
      return false;
    }

    if (
      DIALOGUE_SETUP_SIGNAL.test(
        tail
      )
    ) {
      return true;
    }

    const quotedEnding =
      tail.match(
        /["“]([^"”]{1,450})["”]?\s*$/
      );

    if (
      quotedEnding &&
      quotedEnding[1]
    ) {
      const spoken =
        quotedEnding[1]
          .trim()
          .toLowerCase();

      if (
        /\b(?:because|but|and|so|except|unless|until|if|when|while|the reason|the thing|here['’]s)\s*(?:[,.:;—-]|\.\.\.)?\s*$/i
          .test(
            spoken
          )
      ) {
        return true;
      }
    }

    return false;
  };


  const looksLikePlayerDialogue = (
    value
  ) => {
    const text =
      String(value || "")
        .trim();

    if (
      !text
    ) {
      return false;
    }

    if (
      /["“][^"”]{2,}["”]/.test(
        text
      )
    ) {
      return true;
    }

    if (
      /\b(?:i|you)\s+(?:say|tell|ask|shout|yell|scream|taunt|threaten|whisper|reply|answer|insult|mock|call out|announce)\b/i
        .test(
          text
        )
    ) {
      return true;
    }

    return false;
  };


  /*
   * ============================================================
   * ARC BLOCK CLEANUP
   * ============================================================
   */

  const stripArcBlocks = (value) =>
    String(value || "")
      .replace(
        /\n?\[ARC CORE RULES\][\s\S]*?\[\/ARC CORE RULES\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC COMBAT RULES\][\s\S]*?\[\/ARC COMBAT RULES\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC ANTI-REPETITION\][\s\S]*?\[\/ARC ANTI-REPETITION\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC LOOP BREAKER\][\s\S]*?\[\/ARC LOOP BREAKER\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC RELEVANT STORY CARDS\][\s\S]*?\[\/ARC RELEVANT STORY CARDS\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC TURN DIRECTIVE\][\s\S]*?\[\/ARC TURN DIRECTIVE\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC DIALOGUE CONTINUITY\][\s\S]*?\[\/ARC DIALOGUE CONTINUITY\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC COMPACT RULES\][\s\S]*?\[\/ARC COMPACT RULES\]\n?/g,
        "\n"
      )
      .replace(
        /\n?\[ARC ESSENTIAL RULES\][\s\S]*?\[\/ARC ESSENTIAL RULES\]\n?/g,
        "\n"
      );


  /*
   * ============================================================
   * STORY CARD HELPERS
   * ============================================================
   */

  const getKeys = (card) => {
    if (
      !card ||
      card.keys == null
    ) {
      return [];
    }

    if (
      Array.isArray(
        card.keys
      )
    ) {
      return card.keys
        .map(
          (key) =>
            String(key).trim()
        )
        .filter(Boolean);
    }

    return String(
      card.keys
    )
      .split(
        /[,;\n]/
      )
      .map(
        (key) =>
          key.trim()
      )
      .filter(Boolean);
  };


  const keyAppears = (
    source,
    key
  ) => {
    if (
      !source ||
      !key
    ) {
      return false;
    }

    const trimmed =
      String(key).trim();

    if (
      trimmed.length < 2
    ) {
      return false;
    }

    if (
      /^[a-z0-9_' -]+$/i.test(
        trimmed
      )
    ) {
      const pattern =
        new RegExp(
          `(^|[^a-z0-9_])${escapeRegex(trimmed)}([^a-z0-9_]|$)`,
          "i"
        );

      return pattern.test(
        source
      );
    }

    return source
      .toLowerCase()
      .includes(
        trimmed.toLowerCase()
      );
  };


  const cardAlreadyInContext = (
    card,
    contextText
  ) => {
    if (
      !card ||
      !card.entry ||
      !contextText
    ) {
      return false;
    }

    const entry =
      normalize(
        card.entry
      );

    const context =
      normalize(
        contextText
      );

    if (
      !entry ||
      !context
    ) {
      return false;
    }

    if (
      entry.length <= 700
    ) {
      return context.includes(
        entry
      );
    }

    const fingerprintSize =
      180;

    const start =
      entry.slice(
        0,
        fingerprintSize
      );

    const middleStart =
      Math.max(
        0,
        Math.floor(
          entry.length / 2
        ) -
          Math.floor(
            fingerprintSize / 2
          )
      );

    const middle =
      entry.slice(
        middleStart,
        middleStart +
          fingerprintSize
      );

    const end =
      entry.slice(
        Math.max(
          0,
          entry.length -
            fingerprintSize
        )
      );

    let matches =
      0;

    if (
      start &&
      context.includes(start)
    ) {
      matches++;
    }

    if (
      middle &&
      context.includes(middle)
    ) {
      matches++;
    }

    if (
      end &&
      context.includes(end)
    ) {
      matches++;
    }

    return matches >= 2;
  };


  /*
   * ============================================================
   * NORMAL CONTEXT HISTORY DE-DUPLICATION
   * ============================================================
   *
   * Disabled in Optimized Context mode because optimized mode
   * preserves the host-provided prefix instead of rewriting it.
   */

  const dedupeContextHistory = (
    value
  ) => {
    const paragraphs =
      splitParagraphs(
        value
      );

    const kept =
      [];

    const recent =
      [];

    for (
      const paragraph of paragraphs
    ) {
      const norm =
        normalize(
          paragraph
        );

      const substantial =
        norm.length >= 100;

      const duplicate =
        substantial &&
        recent.some(
          (previous) =>
            isDuplicate(
              paragraph,
              previous,
              0.92,
              100
            )
        );

      if (
        duplicate
      ) {
        continue;
      }

      kept.push(
        paragraph
      );

      if (
        substantial
      ) {
        recent.push(
          paragraph
        );

        if (
          recent.length >
            CONFIG.CONTEXT_DEDUPE_WINDOW
        ) {
          recent.shift();
        }
      }
    }

    return kept.join(
      "\n\n"
    );
  };


  /*
   * ============================================================
   * STATE
   * ============================================================
   */

  const prepareState = () => {
    const action =
      info.actionCount || 0;

    if (
      typeof state.arcLastActionCount ===
        "number" &&
      action <
        state.arcLastActionCount
    ) {
      delete state.arcCombatUntil;
      delete state.arcCombatCards;
      delete state.arcTurnDirective;
      delete state.arcTurnDirectiveAction;
      delete state.arcPreviousPlayerInput;
      delete state.arcLoopBreakTurns;
      delete state.arcForceLoopBreak;
      delete state.arcDialogueContinuityPending;
      delete state.arcOptimizedContext;
    }

    state.arcLastActionCount =
      action;

    state.arcCombatCards =
      state.arcCombatCards ||
      {};

    /*
     * Record the actual mode AI Dungeon reports.
     */
    state.arcOptimizedContext =
      optimizedContextEnabled();

    /*
     * Output can request stronger loop handling.
     */
    if (
      state.arcForceLoopBreak
    ) {
      state.arcLoopBreakTurns =
        Math.max(
          state.arcLoopBreakTurns ||
            0,
          CONFIG.LOOP_BREAK_TURNS
        );

      state.arcForceLoopBreak =
        false;
    }

    return action;
  };


  const combatActive = (
    action =
      info.actionCount || 0
  ) =>
    (
      typeof state.arcCombatUntil ===
        "number" &&
      state.arcCombatUntil >= action
    );


  /*
   * ============================================================
   * TURN DIRECTIVE
   * ============================================================
   */

  const buildTurnDirective = (
    inputText,
    wasRepeated,
    activeCombat
  ) => {
    const parts = [
      "Resolve the newest player input exactly once. Treat declared outcomes, quantities, finishing claims, and speed blitz claims as attempts. Do not simply echo or paraphrase the player's wording; begin with a new reaction, consequence, continuation, or development."
    ];

    if (
      looksLikePlayerDialogue(
        inputText
      )
    ) {
      parts.push(
        "The player directly addressed someone. If that character is present, conscious, capable of responding, and not forced into an immediate emergency reaction, allow a natural in-character reply instead of skipping straight to an unrelated attack. They may respond while moving, defending, preparing, or attacking."
      );
    }

    if (
      wasRepeated
    ) {
      parts.push(
        "The player intentionally repeated a similar action. Resolve it as a NEW attempt from the CURRENT position, injuries, fatigue, energy, defenses, and reactions. Do not reuse the previous narration or outcome wording."
      );
    }

    if (
      activeCombat
    ) {
      parts.push(
        "Combat remains active and autonomous. Other capable combatants may react, interrupt, defend, counter, reposition, speak, or continue their own fights. Do not assume forward progress requires an immediate attack."
      );
    }

    if (
      /\b(?:\d{2,}|hundreds?|thousands?|million|billion)\b/i
        .test(
          inputText
        )
    ) {
      parts.push(
        "Any declared large quantity is aspirational rather than guaranteed. Only narrate the amount physically achieved before defense, interruption, exhaustion, or changing circumstances stop it."
      );
    }

    return parts.join(
      " "
    );
  };


  /*
   * ============================================================
   * STORY CARD TRACKING
   * ============================================================
   */

  const trackRelevantCards = (
    active
  ) => {
    const cards =
      Array.isArray(
        storyCards
      )
        ? storyCards
        : [];

    const historyList =
      Array.isArray(
        history
      )
        ? history
        : [];

    const action =
      info.actionCount || 0;

    if (
      !active ||
      !cards.length
    ) {
      return cards;
    }

    const recentCombatText =
      historyList
        .slice(-6)
        .map(
          (item) =>
            (
              item &&
              item.text
            ) ||
            ""
        )
        .join("\n");

    const scored =
      [];

    for (
      const card of cards
    ) {
      if (
        !card ||
        !card.entry
      ) {
        continue;
      }

      const keys =
        getKeys(
          card
        );

      const matchingKeys =
        keys.filter(
          (key) =>
            keyAppears(
              recentCombatText,
              key
            )
        );

      if (
        !matchingKeys.length
      ) {
        continue;
      }

      const entry =
        String(
          card.entry
        );

      const type =
        String(
          card.type ||
            ""
        );

      let score =
        matchingKeys.length *
        3;

      if (
        /character|npc|enemy|boss|person|creature|monster|ally|companion/i
          .test(
            type
          )
      ) {
        score += 4;
      }

      if (
        /strength|speed|power|ability|abilities|skill|combat|durability|weapon|magic|technique|weakness|resistance|energy|stamina|esper|haki|devil fruit/i
          .test(
            entry
          )
      ) {
        score += 2;
      }

      scored.push({
        card,
        score
      });
    }

    scored
      .sort(
        (a, b) =>
          b.score -
          a.score
      )
      .slice(
        0,
        CONFIG.MAX_ACTIVE_CARDS
      )
      .forEach(
        ({ card }) => {
          state.arcCombatCards[
            String(
              card.id
            )
          ] =
            action;
        }
      );

    for (
      const id of
      Object.keys(
        state.arcCombatCards
      )
    ) {
      if (
        action -
          state.arcCombatCards[id] >
        CONFIG.CARD_MEMORY_ACTIONS
      ) {
        delete state
          .arcCombatCards[id];
      }
    }

    return cards;
  };


  /*
   * ============================================================
   * STORY CARD BACKUP BLOCK
   * ============================================================
   */

  const buildRelevantCardsBlock = (
    cards,
    contextText,
    active,
    budget =
      CONFIG.MAX_CARD_CONTEXT_CHARS
  ) => {
    if (
      !active ||
      budget <= 0
    ) {
      return "";
    }

    const activeCards =
      cards.filter(
        (card) =>
          card &&
          Object.prototype
            .hasOwnProperty
            .call(
              state.arcCombatCards,
              String(
                card.id
              )
            )
      );

    if (
      !activeCards.length
    ) {
      return "";
    }

    let remaining =
      Math.min(
        CONFIG.MAX_CARD_CONTEXT_CHARS,
        budget
      );

    /*
     * Leave room for wrapper text.
     */
    remaining =
      Math.max(
        0,
        remaining - 650
      );

    const pieces =
      [];

    for (
      const card of
      activeCards.slice(
        0,
        CONFIG.MAX_ACTIVE_CARDS
      )
    ) {
      if (
        remaining <= 0
      ) {
        break;
      }

      /*
       * AI Dungeon already supplied this card naturally.
       */
      if (
        cardAlreadyInContext(
          card,
          contextText
        )
      ) {
        continue;
      }

      const keys =
        getKeys(
          card
        ).join(", ");

      const label =
        keys
          ? `Story Card (${keys})`
          : `Story Card ${card.id}`;

      const fullEntry =
        String(
          card.entry ||
            ""
        ).trim();

      if (
        !fullEntry
      ) {
        continue;
      }

      const prefix =
        `\n${label}:\n`;

      const room =
        Math.max(
          0,
          remaining -
            prefix.length
        );

      if (
        room <= 0
      ) {
        break;
      }

      const piece =
        prefix +
        fullEntry.slice(
          0,
          room
        );

      pieces.push(
        piece
      );

      remaining -=
        piece.length;
    }

    if (
      !pieces.length
    ) {
      return "";
    }

    return `
[ARC RELEVANT STORY CARDS]

These Story Card facts are relevant to characters or entities currently involved in combat.

Use them as established baseline information when determining power, speed, durability, skill, abilities, equipment, techniques, weaknesses, resistances, energy, and limitations.

Recent injuries, fatigue, energy use, equipment changes, transformations, positioning, and other current conditions override baseline values when applicable.

${pieces.join("\n")}

[/ARC RELEVANT STORY CARDS]
`;
  };


  /*
   * ============================================================
   * LOOP DETECTION
   * ============================================================
   */

  const recentLoopRisk = () => {
    const historyList =
      Array.isArray(
        history
      )
        ? history
        : [];

    const recentAI =
      historyList
        .filter(
          (item) =>
            item &&
            item.type ===
              "continue" &&
            item.text
        )
        .slice(-2);

    if (
      recentAI.length < 2
    ) {
      return false;
    }

    if (
      hasDuplicateParagraph(
        recentAI[0].text,
        recentAI[1].text,
        0.84
      )
    ) {
      return true;
    }

    return (
      similarity(
        recentAI[0].text,
        recentAI[1].text
      ) >= 0.60
    );
  };


  /*
   * ============================================================
   * INPUT
   * ============================================================
   */

  const onInput = (
    text
  ) => {
    const action =
      prepareState();

    const input =
      String(
        text || ""
      );

    if (
      END_SIGNAL.test(
        input
      )
    ) {
      state.arcCombatUntil =
        -1;

      state.arcCombatCards =
        {};
    } else if (
      COMBAT_SIGNAL.test(
        input
      )
    ) {
      state.arcCombatUntil =
        action +
        CONFIG.COMBAT_GRACE_ACTIONS;
    } else if (
      combatActive(
        action
      )
    ) {
      /*
       * Dialogue and non-attack actions during a fight should not
       * immediately make combat disappear.
       */
      state.arcCombatUntil =
        Math.max(
          state.arcCombatUntil,
          action + 2
        );
    }

    const currentNorm =
      normalize(
        input
      );

    const previousNorm =
      normalize(
        state.arcPreviousPlayerInput ||
          ""
      );

    const wasRepeated =
      currentNorm.length >= 20 &&
      currentNorm === previousNorm;

    state.arcTurnDirective =
      buildTurnDirective(
        input,
        wasRepeated,
        combatActive(
          action
        )
      );

    state.arcTurnDirectiveAction =
      action;

    state.arcPreviousPlayerInput =
      input;

    if (
      wasRepeated
    ) {
      state.arcLoopBreakTurns =
        Math.max(
          state.arcLoopBreakTurns ||
            0,
          1
        );
    }

    return {
      text
    };
  };


  /*
   * ============================================================
   * NORMAL CONTEXT BUILDER
   * ============================================================
   */

  const buildNormalContext = (
    incomingText,
    directives,
    turnDirective
  ) => {
    const cleanedText =
      stripArcBlocks(
        incomingText
      );

    const memoryLength =
      Math.min(
        info.memoryLength ||
          0,
        cleanedText.length
      );

    const memoryPart =
      memoryLength
        ? cleanedText.slice(
            0,
            memoryLength
          )
        : "";

    let storyPart =
      memoryLength
        ? cleanedText.slice(
            memoryLength
          )
        : cleanedText;

    storyPart =
      dedupeContextHistory(
        storyPart
      );

    const maxChars =
      info.maxChars ||
      (
        memoryPart.length +
        directives.length +
        storyPart.length +
        turnDirective.length +
        1000
      );

    const availableStoryChars =
      Math.max(
        0,
        maxChars -
          memoryPart.length -
          directives.length -
          turnDirective.length -
          4
      );

    storyPart =
      availableStoryChars > 0
        ? storyPart.slice(
            -availableStoryChars
          )
        : "";

    return [
      memoryPart,
      directives,
      storyPart,
      turnDirective
    ]
      .filter(Boolean)
      .join("\n");
  };


  /*
   * ============================================================
   * OPTIMIZED CONTEXT BUILDER
   * ============================================================
   *
   * IMPORTANT:
   *
   * In Optimized Context mode ARC avoids rebuilding or
   * de-duplicating AI Dungeon's existing prompt.
   *
   * Instead, it keeps the incoming text intact and appends ARC's
   * instructions into whatever free room is available.
   */

  const buildOptimizedContext = (
    incomingText,
    fullRules,
    active,
    cards,
    dialoguePending,
    loopRisk,
    turnDirective
  ) => {
    const original =
      String(
        incomingText || ""
      );

    const maxChars =
      (
        typeof info.maxChars ===
          "number" &&
        info.maxChars > 0
      )
        ? info.maxChars
        : (
            original.length +
            fullRules.length +
            CONFIG.MAX_CARD_CONTEXT_CHARS +
            2000
          );

    let room =
      Math.max(
        0,
        maxChars -
          original.length -
          CONFIG.OPTIMIZED_CONTEXT_MARGIN
      );

    if (
      room <= 0
    ) {
      /*
       * Preserve the host context rather than destroying its
       * cache-efficient prefix just to force extra text in.
       */
      return original;
    }


    /*
     * ----------------------------------------------------------
     * DYNAMIC HIGH-PRIORITY BLOCKS
     * ----------------------------------------------------------
     */

    const dynamicCandidates =
      [];

    /*
     * Turn directive is especially important because it describes
     * exactly how to resolve the newest player input.
     */
    if (
      turnDirective
    ) {
      dynamicCandidates.push(
        turnDirective
      );
    }

    if (
      dialoguePending
    ) {
      dynamicCandidates.push(
        DIALOGUE_CONTINUITY
      );
    }

    if (
      loopRisk
    ) {
      dynamicCandidates.push(
        LOOP_BREAKER
      );
    }

    const chosenDynamic =
      [];

    /*
     * Save room for at least a minimal permanent ruleset.
     */
    let dynamicBudget =
      Math.max(
        0,
        room -
          OPTIMIZED_MINIMAL_RULES.length -
          4
      );

    for (
      const block of dynamicCandidates
    ) {
      if (
        block.length <=
          dynamicBudget
      ) {
        chosenDynamic.push(
          block
        );

        dynamicBudget -=
          block.length + 1;
      }
    }

    const dynamicText =
      chosenDynamic.join(
        "\n"
      );

    let remainingAfterDynamic =
      Math.max(
        0,
        room -
          dynamicText.length -
          (
            dynamicText
              ? 2
              : 0
          )
      );


    /*
     * ----------------------------------------------------------
     * CHOOSE FULL / COMPACT / MINIMAL RULE SET
     * ----------------------------------------------------------
     */

    let ruleBlock =
      "";

    if (
      fullRules.length <=
        remainingAfterDynamic
    ) {
      ruleBlock =
        fullRules;
    } else if (
      OPTIMIZED_COMPACT_RULES.length <=
        remainingAfterDynamic
    ) {
      ruleBlock =
        OPTIMIZED_COMPACT_RULES;
    } else if (
      OPTIMIZED_MINIMAL_RULES.length <=
        remainingAfterDynamic
    ) {
      ruleBlock =
        OPTIMIZED_MINIMAL_RULES;
    }


    remainingAfterDynamic =
      Math.max(
        0,
        remainingAfterDynamic -
          ruleBlock.length -
          (
            ruleBlock
              ? 2
              : 0
          )
      );


    /*
     * ----------------------------------------------------------
     * STORY CARD BACKUP
     * ----------------------------------------------------------
     *
     * The 10K setting remains the maximum, but Optimized Context
     * automatically uses less when less free room exists.
     */

    const cardsBlock =
      buildRelevantCardsBlock(
        cards,
        original,
        active,
        Math.min(
          CONFIG.MAX_CARD_CONTEXT_CHARS,
          remainingAfterDynamic
        )
      );


    const additions =
      [
        ruleBlock,
        cardsBlock,
        dynamicText
      ]
        .filter(Boolean)
        .join("\n");


    if (
      !additions
    ) {
      return original;
    }


    /*
     * Final guard: never knowingly exceed reported maxChars.
     */

    if (
      original.length +
        additions.length +
        1 >
      maxChars
    ) {
      /*
       * Drop Story Card backup first.
       */
      const withoutCards =
        [
          ruleBlock,
          dynamicText
        ]
          .filter(Boolean)
          .join("\n");

      if (
        withoutCards &&
        original.length +
          withoutCards.length +
          1 <=
        maxChars
      ) {
        return (
          original +
          "\n" +
          withoutCards
        );
      }

      /*
       * Dynamic instructions alone are preferable to mutilating
       * AI Dungeon's optimized prefix.
       */
      if (
        dynamicText &&
        original.length +
          dynamicText.length +
          1 <=
        maxChars
      ) {
        return (
          original +
          "\n" +
          dynamicText
        );
      }

      return original;
    }


    return (
      original +
      "\n" +
      additions
    );
  };


  /*
   * ============================================================
   * CONTEXT
   * ============================================================
   */

  const onContext = (
    text
  ) => {
    const action =
      prepareState();

    const optimized =
      optimizedContextEnabled();

    const historyList =
      Array.isArray(
        history
      )
        ? history
        : [];

    const newest =
      historyList.length
        ? historyList[
            historyList.length -
              1
          ]
        : null;

    const latestAI =
      [...historyList]
        .reverse()
        .find(
          (item) =>
            item &&
            item.type ===
              "continue" &&
            item.text
        );

    if (
      newest &&
      END_SIGNAL.test(
        newest.text ||
          ""
      )
    ) {
      state.arcCombatUntil =
        -1;

      state.arcCombatCards =
        {};
    }

    const active =
      combatActive(
        action
      );

    if (
      !active &&
      typeof state.arcCombatUntil ===
        "number" &&
      state.arcCombatUntil <
        action
    ) {
      state.arcCombatCards =
        {};
    }


    /*
     * ----------------------------------------------------------
     * DIALOGUE CONTINUITY
     * ----------------------------------------------------------
     */

    const dialoguePending =
      Boolean(
        state.arcDialogueContinuityPending
      ) ||
      Boolean(
        latestAI &&
        looksLikeDialogueSetup(
          latestAI.text
        )
      );

    /*
     * Consume it. Output can set it again after this generation.
     */
    state.arcDialogueContinuityPending =
      false;


    /*
     * ----------------------------------------------------------
     * STORY CARDS
     * ----------------------------------------------------------
     */

    const cards =
      trackRelevantCards(
        active
      );


    /*
     * ----------------------------------------------------------
     * LOOP BREAKING
     * ----------------------------------------------------------
     */

    const loopRisk =
      (
        state.arcLoopBreakTurns ||
          0
      ) > 0 ||
      recentLoopRisk();

    if (
      (
        state.arcLoopBreakTurns ||
          0
      ) > 0
    ) {
      state.arcLoopBreakTurns--;
    }


    /*
     * ----------------------------------------------------------
     * TURN DIRECTIVE
     * ----------------------------------------------------------
     */

    const turnDirective =
      (
        state.arcTurnDirective &&
        state.arcTurnDirectiveAction ===
          action
      )
        ? `
[ARC TURN DIRECTIVE]

${state.arcTurnDirective}

[/ARC TURN DIRECTIVE]
`
        : "";


    /*
     * ----------------------------------------------------------
     * BASE RULES
     * ----------------------------------------------------------
     */

    let fullRules =
      CORE_RULES +
      "\n" +
      ANTI_REPEAT;

    if (
      active
    ) {
      fullRules +=
        "\n" +
        COMBAT_RULES;
    }


    /*
     * ==========================================================
     * OPTIMIZED CONTEXT MODE
     * ==========================================================
     */

    if (
      optimized
    ) {
      return {
        text:
          buildOptimizedContext(
            text,
            fullRules,
            active,
            cards,
            dialoguePending,
            loopRisk,
            turnDirective
          )
      };
    }


    /*
     * ==========================================================
     * STANDARD CONTEXT MODE
     * ==========================================================
     */

    const cleanedText =
      stripArcBlocks(
        text
      );

    const cardsBlock =
      buildRelevantCardsBlock(
        cards,
        cleanedText,
        active,
        CONFIG.MAX_CARD_CONTEXT_CHARS
      );

    let directives =
      fullRules;

    if (
      dialoguePending
    ) {
      directives +=
        "\n" +
        DIALOGUE_CONTINUITY;
    }

    if (
      cardsBlock
    ) {
      directives +=
        "\n" +
        cardsBlock;
    }

    if (
      loopRisk
    ) {
      directives +=
        "\n" +
        LOOP_BREAKER;
    }

    return {
      text:
        buildNormalContext(
          text,
          directives,
          turnDirective
        )
    };
  };


  /*
   * ============================================================
   * OUTPUT
   * ============================================================
   */

  const onOutput = (
    text
  ) => {
    const action =
      prepareState();

    /*
     * Output hook also gets direct awareness when AI Dungeon
     * supplies info.useCacheEfficient.
     */
    const optimized =
      optimizedContextEnabled();

    state.arcOptimizedContext =
      optimized;

    const original =
      String(
        text || ""
      );


    /*
     * ----------------------------------------------------------
     * COMBAT STATE
     * ----------------------------------------------------------
     */

    if (
      END_SIGNAL.test(
        original
      )
    ) {
      state.arcCombatUntil =
        -1;

      state.arcCombatCards =
        {};
    } else if (
      !combatActive(
        action
      ) &&
      COMBAT_SIGNAL.test(
        original
      )
    ) {
      /*
       * AI can START combat.
       * AI prose does not continually refresh an already active
       * battle timer.
       */
      state.arcCombatUntil =
        action +
        CONFIG.COMBAT_GRACE_ACTIONS;
    }


    /*
     * ==========================================================
     * PHASE 1 — SAME RESPONSE DUPLICATION
     * ==========================================================
     */

    const generatedParagraphs =
      splitParagraphs(
        original
      );

    const internallyCleaned =
      [];

    let repetitionDetected =
      false;

    for (
      const paragraph of
      generatedParagraphs
    ) {
      const duplicate =
        internallyCleaned.some(
          (previous) =>
            isDuplicate(
              paragraph,
              previous,
              0.82,
              90
            )
        );

      if (
        duplicate
      ) {
        repetitionDetected =
          true;

        continue;
      }

      internallyCleaned.push(
        paragraph
      );
    }


    /*
     * ==========================================================
     * PHASE 2 — RECENT AI HISTORY
     * ==========================================================
     */

    let recentAI =
      Array.isArray(
        history
      )
        ? history
            .filter(
              (item) =>
                item &&
                item.type ===
                  "continue" &&
                item.text
            )
            .slice(
              -CONFIG.RECENT_AI_OUTPUTS
            )
        : [];

    /*
     * Avoid comparing current output against itself.
     */
    if (
      recentAI.length &&
      normalize(
        recentAI[
          recentAI.length - 1
        ].text
      ) ===
        normalize(
          original
        )
    ) {
      recentAI =
        recentAI.slice(
          0,
          -1
        );
    }

    const historicalParagraphs =
      [];

    for (
      const item of recentAI
    ) {
      historicalParagraphs.push(
        ...splitParagraphs(
          item.text
        )
      );
    }

    const novelParagraphs =
      [];

    for (
      const paragraph of
      internallyCleaned
    ) {
      const substantial =
        normalize(
          paragraph
        ).length >= 100;

      const duplicateHistory =
        substantial &&
        historicalParagraphs.some(
          (previous) =>
            isDuplicate(
              paragraph,
              previous,
              0.88,
              100
            )
        );

      if (
        duplicateHistory
      ) {
        repetitionDetected =
          true;

        continue;
      }

      novelParagraphs.push(
        paragraph
      );
    }


    /*
     * ==========================================================
     * PHASE 3 — SECOND INTERNAL PASS
     * ==========================================================
     */

    const secondPass =
      [];

    for (
      const paragraph of
      novelParagraphs
    ) {
      const duplicate =
        secondPass.some(
          (previous) =>
            isDuplicate(
              paragraph,
              previous,
              0.82,
              90
            )
        );

      if (
        duplicate
      ) {
        repetitionDetected =
          true;

        continue;
      }

      secondPass.push(
        paragraph
      );
    }


    /*
     * ==========================================================
     * BUILD OUTPUT
     * ==========================================================
     */

    let cleaned =
      secondPass
        .join("\n\n")
        .trim();


    /*
     * Never intentionally return an empty generation.
     */
    if (
      !cleaned &&
      internallyCleaned.length
    ) {
      cleaned =
        internallyCleaned[
          internallyCleaned.length -
            1
        ].trim();

      repetitionDetected =
        true;
    }

    if (
      !cleaned
    ) {
      cleaned =
        original.trim();
    }


    /*
     * ==========================================================
     * LOOP BREAK SIGNAL
     * ==========================================================
     */

    if (
      repetitionDetected
    ) {
      state.arcForceLoopBreak =
        true;

      /*
       * Optimized Context cannot perform the same history rewrite
       * as normal mode, so keep the preventative loop instruction
       * active slightly longer when a loop was actually detected.
       */
      state.arcLoopBreakTurns =
        Math.max(
          state.arcLoopBreakTurns ||
            0,
          optimized
            ? CONFIG.LOOP_BREAK_TURNS + 1
            : CONFIG.LOOP_BREAK_TURNS
        );
    }


    /*
     * ==========================================================
     * DIALOGUE CONTINUITY SIGNAL
     * ==========================================================
     */

    state.arcDialogueContinuityPending =
      looksLikeDialogueSetup(
        cleaned
      );


    return {
      text: cleaned
    };
  };


  /*
   * ============================================================
   * EXPOSE ARC API
   * ============================================================
   */

  return {
    onInput,
    onContext,
    onOutput,

    normalize,
    similarity,
    isDuplicate,
    looksLikeDialogueSetup,
    looksLikePlayerDialogue,
    optimizedContextEnabled
  };

})();
